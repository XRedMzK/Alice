{
  "manifest_schema": "nmcm.module/v1alpha1",
  "module_id": "synthetic.a1",
  "module_version": "1.0.0",
  "purpose": {
    "summary": "Learn the canonical continuous recurrent latent dynamics from local synthetic supervision.",
    "scientific_hypothesis": "A locally trained recurrent neural population can expose a stable dense interface usable by a frozen downstream population.",
    "non_goals": ["cognition", "language", "production behavior", "semantic orchestration"]
  },
  "input_interfaces": [
    {"interface_id": "stimulus", "latent_schema_id": "synthetic_stimulus/v1", "multiplicity": "one", "description": "Continuous x_t in R16."}
  ],
  "output_interfaces": [
    {"interface_id": "dense_latent", "latent_schema_id": "dense_latent/v1", "multiplicity": "one", "description": "Canonical dense recurrent latent in R32."}
  ],
  "input_latent_schema": {
    "stimulus": {
      "schema_version": "synthetic_stimulus/v1",
      "representation": "dense_distributed",
      "representation_contract_id": "nmcm.synthetic.r16.antipodal/v1",
      "normalization": "raw deterministic standard-normal fixture",
      "tensors": [{"name": "value", "rank": 3, "shape": ["batch", "time", 16], "dtype": "float32", "range": "finite"}]
    }
  },
  "output_latent_schema": {
    "dense_latent": {
      "schema_version": "dense_latent/v1",
      "representation": "dense_distributed",
      "representation_contract_id": "nmcm.synthetic.r32.canonical_basis/v1",
      "normalization": "teacher tanh basis; no per-sample normalization",
      "tensors": [{"name": "value", "rank": 3, "shape": ["batch", "time", 32], "dtype": "float32", "range": "[-1,1]"}]
    }
  },
  "private_state_schema": {
    "enabled": true,
    "schema_version": "state/v1",
    "tensors": [{"name": "hidden", "shape": ["batch", 32], "dtype": "float32", "persistent": false}],
    "initialization": "zero at sequence or declared replacement boundary",
    "reset": "explicit whole-tensor zero reset",
    "clone_semantics": "detached storage-disjoint tensor copy"
  },
  "persistent_state_schema": {
    "enabled": false,
    "schema_version": "persistent/none-v1",
    "tensors": [],
    "initialization": "not applicable",
    "reset": "not applicable",
    "clone_semantics": "not applicable"
  },
  "trainable_parameters": {
    "estimated_count": 1568,
    "estimated_bytes": 6272,
    "groups": [{"name": "recurrent_core", "trainable_under": ["local_trainable"]}]
  },
  "frozen_dependencies": [],
  "update_frequency": {"unit": "sequence", "value": 1, "phase_offset": 0},
  "causal_dependencies": [],
  "plasticity_policy": {
    "default_mode": "frozen",
    "allowed_modes": ["frozen", "local_trainable"],
    "state_update_during_frozen_eval": true,
    "constraints": ["optimizer updates are allowed only in the A1 local-learning experiment"]
  },
  "checkpoint_schema": {
    "schema_version": "nmcm.shard/v2",
    "shard_format": "safetensors",
    "includes": ["parameters", "private_state"],
    "integrity": "sha256",
    "atomic_write": true,
    "migration_id": null
  },
  "resource_budget": {
    "parameter_bytes": 6272,
    "private_state_bytes": 128,
    "persistent_state_bytes": 0,
    "estimated_active_vram_peak_mib": 0,
    "incremental_active_vram_reservation_mib": 0,
    "estimated_gpu_utilization_contribution_percent": 0,
    "latency_p95_budget_ms": 250,
    "offload_transfer_bytes": 6400,
    "measurement_method": "exact owned CPU tensor bytes; GPU NOT_RUN",
    "measurement_workload": "batch=1,time=8,float32",
    "measurement_window": "one complete sequence"
  },
  "local_acceptance_tests": [
    {"test_id": "cpu.04.a1_local_learning", "metric": "heldout mean cosine and normalized RMSE", "pass_criterion": "cosine>=0.98 and NRMSE<=0.10; training loss decreases"}
  ],
  "causal_ablation_tests": [
    {"test_id": "cpu.09.targeted_ablation", "metric": "frozen-B task accuracy loss", "pass_criterion": "absolute loss>=0.25", "non_target_guards": ["A parameters and state are not mutated by the intervention", "C branch is unchanged when present"]}
  ],
  "integration_tests": [
    {"test_id": "cpu.06.a1_to_b", "metric": "frozen-B heldout accuracy", "pass_criterion": "accuracy>=0.95"}
  ],
  "parallel_execution_safety": {
    "mode": "isolated_clone_required",
    "shared_mutable_neural_state": false,
    "candidate_isolation": "each candidate bundle loads independent parameters and private state",
    "artifact_isolation": "unique worker artifact root and run ID"
  },
  "offload_policy": {
    "allowed": true,
    "destinations": ["gpu", "ram"],
    "state_components": ["parameters", "private_state"],
    "safe_boundary": "zero-reset sequence boundary",
    "max_round_trip_ms": 900000,
    "state_tolerance": 0,
    "max_transfers_per_minute": 4
  },
  "compatibility_version": "dense_latent/v1",
  "telemetry": {
    "schema_version": "nmcm.telemetry/v2",
    "required_metrics": ["module_id", "module_version", "compatibility_version", "lifecycle_state", "current_experiment", "latency_ms", "cpu_time_ms", "gpu_time_ms", "active_vram_mib", "active_vram_peak_mib", "gpu_utilization_mean_percent", "gpu_utilization_peak_percent", "process_peak_memory_bytes", "parameter_bytes", "private_state_bytes", "state_statistics", "activation_statistics", "output_statistics", "checkpoint_schema_version", "state_schema_version", "snapshot_id", "local_status", "transfer_statistics"],
    "sampling_policy": "one post-forward event per executed module; GPU values null on CPU"
  },
  "provenance": {
    "human_spec": "MODULE_CONTRACT.md and configs/foundation0_cpu.json",
    "source_revision": "foundation0-cpu-v1-working-tree",
    "created_by": "Codex under user-approved temp.md"
  }
}
