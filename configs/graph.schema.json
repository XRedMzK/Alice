{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nmcm/graph.schema.json",
  "title": "NMCM fixed neural graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_schema", "graph_id", "graph_version", "execution_mode", "nodes", "edges", "outputs", "provider_admissions"],
  "properties": {
    "graph_schema": {"const": "nmcm.graph/v2"},
    "graph_id": {"type": "string", "minLength": 1},
    "graph_version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
    "execution_mode": {"enum": ["admitted", "negative_test"]},
    "provider_admissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "role", "consumer_node", "fixture_id", "fixture_digest", "consumer_artifact_digest", "thresholds_digest"],
        "properties": {
          "node": {"type": "string", "minLength": 1},
          "role": {"enum": ["baseline", "replacement", "negative_control"]},
          "consumer_node": {"type": "string", "minLength": 1},
          "fixture_id": {"type": "string", "minLength": 1},
          "fixture_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "consumer_artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "thresholds_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "module_id", "module_version"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "module_id": {"type": "string", "minLength": 1},
          "module_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/edge"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "name"],
        "properties": {
          "source": {"$ref": "#/$defs/endpoint"},
          "name": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "port"],
      "properties": {
        "node": {"type": "string", "minLength": 1},
        "port": {"type": "string", "minLength": 1}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {"$ref": "#/$defs/endpoint"},
        "target": {"$ref": "#/$defs/endpoint"}
      }
    }
  }
}
